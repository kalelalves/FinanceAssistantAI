@page "/"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>FinIA</PageTitle>

<main class="workspace">
    <section class="chat-shell">
        <header class="chat-header">
            <div>
                <h1>FinIA</h1>
                <p>Analise fundamentalista objetiva para ate 10 papeis.</p>
            </div>
            <span>@TickerCount/10 papeis</span>
        </header>

        <div class="chat-thread" aria-live="polite">
            @foreach (var message in messages)
            {
                <article class="chat-message @message.Role">
                    <p>@message.Text</p>
                </article>
            }

            @if (isLoading)
            {
                <article class="chat-message assistant">
                    <p>Processando analise...</p>
                </article>
            }
        </div>

        @if (analysisResponse?.Results.Count > 0)
        {
            <section class="results-grid" aria-label="Resultados da analise">
                @foreach (var result in analysisResponse.Results)
                {
                    <article class="result-card">
                        <header>
                            <strong>@result.Ticker</strong>
                            <span>@result.Diagnosis</span>
                        </header>
                        <dl>
                            <dt>Preco atual</dt>
                            <dd>@FormatMoney(result.CurrentPrice)</dd>
                            <dt>Preco-alvo</dt>
                            <dd>@FormatMoney(result.TargetPrice)</dd>
                            <dt>Horizonte</dt>
                            <dd>@result.Horizon</dd>
                        </dl>
                        <p>@result.Summary</p>
                    </article>
                }
            </section>
        }

        @if (analysisResponse?.FixedIncomeTips.Count > 0)
        {
            <section class="results-grid" aria-label="Dicas de renda fixa">
                @foreach (var tip in analysisResponse.FixedIncomeTips)
                {
                    <article class="result-card">
                        <header>
                            <strong>@tip.Title</strong>
                        </header>
                        <p>@tip.Detail</p>
                    </article>
                }
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

        <form class="chat-composer" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <textarea
                @bind="chatText"
                @bind:event="oninput"
                placeholder="Ex.: Analise PETR4, VALE3 e ITUB4"
                disabled="@isLoading"></textarea>
            <button type="submit" disabled="@isLoading">Enviar</button>
        </form>
    </section>
</main>

@code {
    private string chatText = "Analise PETR4 e VALE3";
    private string? errorMessage;
    private bool isLoading;
    private ChatResponse? analysisResponse;
    private readonly List<ChatMessage> messages =
    [
        new("assistant", "Digite os papeis que deseja avaliar ou peca dicas de renda fixa.")
    ];

    private int TickerCount => ParseTickers().Count;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        var prompt = chatText.Trim();
        var tickers = ParseTickers();

        if (string.IsNullOrWhiteSpace(prompt))
        {
            errorMessage = "Digite uma mensagem.";
            return;
        }

        if (tickers.Count == 0 && !LooksLikeFixedIncomeQuestion(prompt))
        {
            errorMessage = "Informe ao menos um ticker ou peca dicas de renda fixa.";
            return;
        }

        if (tickers.Count > 10)
        {
            errorMessage = "Limite maximo de 10 papeis.";
            return;
        }

        messages.Add(new ChatMessage("user", prompt));
        chatText = string.Empty;
        isLoading = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/chat", new ChatRequest(prompt));
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Nao consegui concluir a analise agora. Verifique se o backend esta configurado e tente novamente.";
                return;
            }

            analysisResponse = await response.Content.ReadFromJsonAsync<ChatResponse>();
            messages.Add(new ChatMessage(
                "assistant",
                analysisResponse?.Message ?? "Analise concluida."));
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private IReadOnlyCollection<string> ParseTickers()
    {
        return chatText
            .Split([',', ';', ' ', '\n', '\r', '\t', '.', ':'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(token => token.Trim().ToUpperInvariant())
            .Where(token => token.Length is >= 5 and <= 6)
            .Where(token => token.Any(char.IsDigit))
            .Select(ticker => ticker.ToUpperInvariant())
            .Distinct()
            .ToArray();
    }

    private static bool LooksLikeFixedIncomeQuestion(string prompt)
    {
        var normalized = prompt.ToUpperInvariant();
        return normalized.Contains("RENDA FIXA") ||
            normalized.Contains("TESOURO") ||
            normalized.Contains("CDB") ||
            normalized.Contains("LCI") ||
            normalized.Contains("LCA") ||
            normalized.Contains("CRI") ||
            normalized.Contains("CRA") ||
            normalized.Contains("DEBENTURE") ||
            normalized.Contains("CDI") ||
            normalized.Contains("SELIC") ||
            normalized.Contains("IPCA") ||
            normalized.Contains("POUPANCA");
    }

    private static string FormatMoney(decimal? value)
    {
        return value is null ? "n/d" : $"R$ {value:0.00}";
    }

    private sealed record ChatRequest(string Message);

    private sealed record ChatResponse(
        string Message,
        IReadOnlyCollection<AssetResult> Results,
        IReadOnlyCollection<FixedIncomeTip> FixedIncomeTips);

    private sealed record ChatMessage(string Role, string Text);

    private sealed record FixedIncomeTip(string Title, string Detail);

    private sealed record AssetResult(
        string Ticker,
        decimal? CurrentPrice,
        decimal? TargetPrice,
        string Horizon,
        string Diagnosis,
        string Summary);
}
